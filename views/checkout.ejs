<%- include('partials/header') %>

<h1>Checkout</h1>

<% if (tickets.length === 0) { %>
  <p class="muted">You aren't holding any seats. <a href="/">Find an event →</a></p>
<% } else { %>
  <p class="countdown" data-deadline="<%= deadlineMs %>">
    Seats held for <strong class="countdown-time">--:--</strong>
  </p>

  <table>
    <thead>
      <tr><th>Event</th><th>Seat</th><th class="num">Price</th><th></th></tr>
    </thead>
    <tbody>
      <% tickets.forEach((t) => { %>
        <tr>
          <td><strong><%= t.title %></strong><br><span class="muted"><%= t.starts_local %> · <%= t.venue %></span></td>
          <td><%= t.section %>, Row <%= t.row_label %>, Seat <%= t.seat_number %></td>
          <td class="num"><%= money(t.price) %></td>
          <td>
            <form method="post" action="/checkout/release/<%= t.ticket_id %>" class="inline">
              <button class="link">Release</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
    <tfoot>
      <tr><th colspan="2">Total</th><th class="num"><%= money(total) %></th><th></th></tr>
    </tfoot>
  </table>

  <section id="payment" class="payment-card">
    <h2>Pay by card</h2>
    <div class="card-brands" aria-label="Accepted cards">
      <span class="brand-badge" data-brand="visa">VISA</span>
      <span class="brand-badge" data-brand="mastercard">Mastercard</span>
      <span class="brand-badge" data-brand="amex">AMEX</span>
      <span class="brand-badge" data-brand="discover">DISCOVER</span>
    </div>

    <p class="flash flash-info">Demo shop: no real money is charged. Use a test card below, and <strong>never enter a real card</strong>.</p>

    <%# autocomplete="off" stops the browser from offering to fill in saved (real) cards. %>
    <form method="post" action="/checkout/pay" class="card-form" autocomplete="off">
      <label class="wide">Card number
        <input type="text" name="card_number" id="card-number" inputmode="numeric" maxlength="23"
               placeholder="1234 5678 9012 3456" autocomplete="off" required>
      </label>
      <label>Expiry (MM/YY)
        <input type="text" name="card_expiry" id="card-expiry" inputmode="numeric" maxlength="5"
               placeholder="MM/YY" autocomplete="off" required>
      </label>
      <label>Security code
        <input type="text" name="card_cvc" id="card-cvc" inputmode="numeric" maxlength="4"
               placeholder="123" autocomplete="off" required>
      </label>
      <label class="wide">Name on card
        <input type="text" name="card_name" id="card-name" placeholder="<%= customer.full_name %>" autocomplete="off" required>
      </label>
      <button class="wide">Pay <%= money(total) %></button>
    </form>

    <details class="test-cards">
      <summary>Test cards (click one to fill in the form)</summary>
      <table>
        <thead><tr><th>Card</th><th>Number</th><th>What happens</th></tr></thead>
        <tbody>
          <% testCards.forEach((c) => { %>
            <tr>
              <td><%= c.brand %></td>
              <td><button type="button" class="link fill-card" data-number="<%= c.number %>"><code><%= c.number %></code></button></td>
              <td><%= c.outcome %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <p class="muted">Any future expiry date works. The security code is 3 digits (4 for American Express).</p>
    </details>
  </section>

  <script src="/countdown.js"></script>
  <script src="/card-form.js"></script>
<% } %>

<%- include('partials/footer') %>
